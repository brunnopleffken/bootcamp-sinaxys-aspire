@page "/detalhes/{Id:int}"
@rendermode InteractiveServer

@if (MovieDetails is not null)
{
    <h1 class="mb-5">@MovieDetails.Title</h1>

    <div class="row mb-5">
        <div class="col-3">
            <img src="@MovieDetails.CoverImage" class="img-fluid rounded">
        </div>
        <div class="col-9">
            <p>
                <strong>Diretor:</strong> @MovieDetails.Director
            </p>
            <p>
                <strong>Gênero:</strong> ---
            </p>
            <p>
                <strong>Data de lançamento:</strong> @MovieDetails.ReleaseDate.ToShortDateString()
            </p>
            <p>
                <strong>Duração:</strong> @MovieDetails.Duration minutos
            </p>
            <p>
                <strong>Classificação etária:</strong> @MovieDetails.Rating
            </p>
            <p>@MovieDetails.Description</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Avaliações</h4>
        <a href="#" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#add-movie">Adicionar avaliação</a>
    </div>

    @if (Reviews is not null)
    {
        @foreach (Review review in Reviews)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">
                    <p><strong>@review.User.Name</strong> &middot; @review.CreatedAt.LocalDateTime.ToString() &middot; [][][][][]</p>
                    <p class="mb-0">@review.Comment</p>
                </div>
            </div>
        }
    }

    <div class="modal fade" tabindex="-1" id="add-movie">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Adicionar avaliação</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div>
                        <label for="" class="form-label">Nota</label>
                        <div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="option1">
                                <label class="form-check-label" for="inlineRadio1">1</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="option2">
                                <label class="form-check-label" for="inlineRadio2">2</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio3" value="option3">
                                <label class="form-check-label" for="inlineRadio3">3</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio4" value="option4">
                                <label class="form-check-label" for="inlineRadio3">4</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio5" value="option5">
                                <label class="form-check-label" for="inlineRadio3">5</label>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label for="" class="form-label">Comentários</label>
                        <textarea name="" id="" rows="10" class="form-control" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary">Enviar avaliação</button>
                </div>
            </div>
        </div>
    </div>
}


@code
{
    [Parameter]
    public int Id { get; set; }

    public MovieDetailResponse? MovieDetails { get; set; }
    public List<Review>? Reviews { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HttpClient client = HttpClientFactory.CreateClient("KatalogAPI");
        MovieDetailResponse? moviesResponse = await client.GetFromJsonAsync<MovieDetailResponse>($"/Movies/{Id}");
        List<Review>? reviewsResponse = await client.GetFromJsonAsync<List<Review>>($"/Reviews/{Id}");

        if (moviesResponse is not null)
            MovieDetails = moviesResponse;

        if (reviewsResponse is not null)
            Reviews = reviewsResponse;
    }

    // Movies DTO

    public record MovieDetailResponse(
        int Id,
        string Title,
        string? Description,
        DateOnly ReleaseDate,
        string? CoverImage,
        TimeOnly Duration,
        Rating Rating,
        decimal? VoteAverage,
        string? Director,
        DateTime CreatedAt,
        DateTime UpdatedAt);

    // Reviews DTO

    public record Review(
        int Id,
        string Comment,
        int Rating,
        DateTimeOffset CreatedAt,
        User User);

    public record User(string Name);

    // Enums

    public enum Rating
    {
        L,
        A10,
        A12,
        A14,
        A16,
        A18
    }
}
